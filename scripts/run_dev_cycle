#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
mode=${1:-fast}

if [ "$mode" != "fast" ] && [ "$mode" != "full" ]; then
    echo "Usage: scripts/run_dev_cycle [fast|full]" >&2
    exit 2
fi

if [ -n "${MATLAB_BIN:-}" ]; then
    matlab_bin=$MATLAB_BIN
elif [ -x "/Applications/MATLAB_R2024a.app/bin/matlab" ]; then
    matlab_bin="/Applications/MATLAB_R2024a.app/bin/matlab"
elif command -v matlab >/dev/null 2>&1; then
    matlab_bin=$(command -v matlab)
else
    echo "Could not find MATLAB. Set MATLAB_BIN to its executable." >&2
    exit 1
fi

cd "$repo_root"
git diff --check
python3 -m py_compile +Wrapper/advanced_method_bridge.py \
    +Wrapper/cellpose_centroids.py +Wrapper/yolo_centroids.py \
    +Wrapper/resource_control.py +Wrapper/moe_inference.py +Wrapper/reference_video.py +Wrapper/read_czi.py
python3 scripts/test_frozen_spotiflow_bridge.py
python3 scripts/check_mlapp_drift.py
python3 scripts/test_resource_control.py
python3 scripts/test_performance_app_contract.py

matlab_command="cd('$repo_root'); files={'+Tracking/ReferenceAnalysisView.m','+Tracking/ReferenceView.m','+Tracking/ReferenceWorkflow.m','+Program/+Routines/open.m','+Tracking/BackendRegistry.m','+Tracking/JobContract.m','+Tracking/JobIO.m','+Tracking/ResultAdapter.m','+DataHandling/+Helpers/large_file.m','+DataHandling/NeuroPALImage.m','+DataHandling/writeTrackMate.m','+Program/+Dev/LargeFileHarness.m','+Program/+Dev/UIHarness.m','+Program/+GUI/setup_zephir_video_tab.m','+Program/+GUI/update_zephir_video_tab.m','+Program/+Routines/+ID/get_slice.m','+Methods/MethodBundle.m','+Methods/MethodContract.m','+Methods/MethodRegistry.m','+Methods/SpotiflowDetect.m','+Methods/TransformerAutoId.m','+Wrapper/runSpotiflowCentroids.m','+Program/GUIHandling.m','+Program/HeavyJob.m','+Program/LatestSlicePreview.m','+Wrapper/PythonJob.m','+Wrapper/runPythonProcess.m','+Wrapper/runMoECentroids.m','+Methods/ColorReadout.m','+DataHandling/+Helpers/npal_mat.m','+DataHandling/+Helpers/bioformats_image.m','+DataHandling/+Helpers/nwb_stream_export.m','+DataHandling/+Helpers/process_mat_transaction.m','+Program/+Helpers/main_slice_image.m','+Program/+Helpers/video_render_views.m'}; issue_count=0; for i=1:numel(files), issues=checkcode(files{i},'-id'); if ~isempty(issues), fprintf('ANALYZER: %s\\n',files{i}); disp(struct2table(issues)); end; issue_count=issue_count+numel(issues); end; assert(issue_count==0,sprintf('Code Analyzer reported %d issue(s).',issue_count)); addpath(fullfile(pwd,'scripts')); test_method_registry; test_advanced_method_scaffolds; test_tracking_contracts; test_tracking_job_io; test_tracking_result_adapter; test_large_file_policy; test_neuropal_image_loader; test_trackmate_export; test_open_callback_contract; test_performance_contracts; fprintf('DEV_CYCLE_FAST=PASS\\n');"

if [ "$mode" = "full" ]; then
    timestamp=$(date +"%Y%m%d_%H%M%S")
    artifact_root="$repo_root/.ui_artifacts/dev-cycle-$timestamp"
    image_fixture=${NPAL_UI_AUDIT_FIXTURE:-/Users/adamg/neuroPAL/6_mYAa.mat}
    video_fixture=${NPAL_UI_AUDIT_VIDEO_FIXTURE:-/Users/adamg/neuroPAL/ZephIR_example_data/neuroPAL_ID_compatible/data.h5}
    large_fixture=${NPAL_LARGE_FILE_FIXTURE:-/Users/adamg/neuroPAL/sub-20220630-h8_ses-20220630_ophys.nwb}

    if [ ! -f "$image_fixture" ] || [ ! -f "$video_fixture" ] || [ ! -f "$large_fixture" ]; then
        echo "Full mode requires valid image, video, and NWB fixtures." >&2
        exit 1
    fi

    export NPAL_UI_AUDIT_FIXTURE="$image_fixture"
    export NPAL_UI_AUDIT_VIDEO_FIXTURE="$video_fixture"
    export NPAL_LARGE_FILE_FIXTURE="$large_fixture"
    export NPAL_DEV_CYCLE_ARTIFACT_ROOT="$artifact_root"
    matlab_command="$matlab_command Program.Dev.UIHarness.run('OutputDir',fullfile(getenv('NPAL_DEV_CYCLE_ARTIFACT_ROOT'),'ui'),'Fixture',getenv('NPAL_UI_AUDIT_FIXTURE'),'VideoFixture',getenv('NPAL_UI_AUDIT_VIDEO_FIXTURE')); Program.Dev.LargeFileHarness.run(getenv('NPAL_LARGE_FILE_FIXTURE'),fullfile(getenv('NPAL_DEV_CYCLE_ARTIFACT_ROOT'),'large-file')); fprintf('DEV_CYCLE_FULL=PASS\\n');"
fi

resource_dir="$repo_root/.ui_artifacts/dev-cycle-resources"
mkdir -p "$resource_dir"
python3 +Wrapper/resource_control.py --report "$resource_dir/$(date +%Y%m%d_%H%M%S).jsonl" \
    -- "$matlab_bin" -singleCompThread -batch "$matlab_command"

if [ "$mode" = "full" ]; then
    echo "Full audit artifacts: $artifact_root"
fi

echo "NeuroPAL development cycle ($mode): PASS"
